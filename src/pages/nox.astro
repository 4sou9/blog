---
const base = import.meta.env.BASE_URL;

const brow  = (ns: number[]) => ns.map((n,i) => ({n, t:80, l:5+12*i, w:8,  layer:'sm', anim:'blink', delay:+(i*.35).toFixed(2)}));
const lcol  = (ns: number[]) => ns.map((n,i) => ({n, t:6+14*i,    l:3,  w:8,  layer:'sm', anim:'blink', delay:+(i*.35).toFixed(2)}));
const rcol  = (ns: number[]) => ns.map((n,i) => ({n, t:6+14*i,    l:90, w:8,  layer:'sm', anim:'blink', delay:+(i*.35).toFixed(2)}));
const rclst = (ns: number[]) => ns.map((n,i) => ({n, t:i<3?70:82, l:62+10*(i%3), w:7, layer:'sm', anim:'blink', delay:[0,.4,.8,.2,.6,1.0][i]}));

// Rooms 1–7 only — room 0 is custom monitor theme
const rooms = [
  { id:'r1', ac:'#0088ee', label:'01',
    shapes:[ {n:10,t:5,l:32,w:38,layer:'hi',anim:'flick'}, {n:11,t:50,l:5,w:18,layer:'md',anim:'jump-r'}, {n:12,t:42,l:70,w:18,layer:'md',anim:'wink'}, ...rclst([13,14,15,16,17,18]) ],
    frags:[ {t:3,l:3,txt:'SECTOR·01'},{t:8,l:74,txt:'144.220 MHz'},{t:88,l:5,txt:'SIGNAL ACQUIRED'},{t:46,l:34,txt:'≋≋≋≋≋',op:.14},{t:22,l:5,txt:'NOISE: −0.03 dB',op:.10},{t:60,l:38,txt:'0x7F / 0xFF',op:.10},{t:84,l:72,txt:'SOURCE: UNKNOWN',op:.08} ],
    syms:[ {t:40,l:24,sz:22,sym:'g-arc',op:.18},{t:65,l:40,sz:18,sym:'g-orb',op:.12} ] },
  { id:'r2', ac:'#00aa44', label:'02',
    shapes:[ {n:19,t:5,l:35,w:38,layer:'hi',anim:'flick'}, {n:20,t:48,l:74,w:18,layer:'md',anim:'wink'}, {n:21,t:55,l:54,w:18,layer:'md',anim:'jump'}, ...lcol([22,23,24,25,26,27]) ],
    frags:[ {t:3,l:3,txt:'SECTOR·02'},{t:7,l:74,txt:'ARCHIVE ACCESS GRANTED'},{t:91,l:14,txt:'128 RECORDS / INTEGRITY 94.7%'},{t:44,l:38,txt:'◈',op:.16},{t:28,l:74,txt:'0x4E7F',op:.10},{t:60,l:58,txt:'CHECKSUM: OK',op:.08} ],
    syms:[ {t:38,l:70,sz:24,sym:'g-hex',op:.20},{t:68,l:60,sz:18,sym:'g-prx',op:.12} ] },
  { id:'r3', ac:'#ee2233', label:'03',
    shapes:[ {n:28,t:5,l:22,w:38,layer:'hi',anim:'flick-fast'}, {n:29,t:52,l:64,w:18,layer:'md',anim:'jump-r'}, {n:30,t:44,l:5,w:18,layer:'md',anim:'wink'}, ...brow([31,32,33,34,35,36]) ],
    frags:[ {t:3,l:3,txt:'SECTOR·03'},{t:8,l:64,txt:'ANOMALY DETECTED — CAUTION'},{t:90,l:5,txt:'ERR: 0xDEAD — SECTOR.03'},{t:40,l:26,txt:'⚠',op:.22},{t:20,l:64,txt:'CRITICAL',op:.12},{t:62,l:42,txt:'PROTOCOL: VOID',op:.08} ],
    syms:[ {t:42,l:48,sz:26,sym:'g-prx',op:.20},{t:70,l:40,sz:18,sym:'g-orb',op:.12} ] },
  { id:'r4', ac:'#00bbcc', label:'04',
    shapes:[ {n:37,t:5,l:40,w:38,layer:'hi',anim:'flick'}, {n:38,t:50,l:5,w:18,layer:'md',anim:'jump'}, {n:39,t:42,l:74,w:18,layer:'md',anim:'wink'}, ...rclst([40,41,42,43,44,45]) ],
    frags:[ {t:3,l:3,txt:'SECTOR·04'},{t:8,l:80,txt:'8 NODES ACTIVE'},{t:90,l:5,txt:'LATENCY: 0.4ms / LOSS: 0.0%'},{t:44,l:42,txt:'⬡',op:.16},{t:58,l:38,txt:'DEPTH: ∞',op:.10} ],
    syms:[ {t:38,l:28,sz:24,sym:'g-orb',op:.18},{t:65,l:50,sz:18,sym:'g-hex',op:.12} ] },
  { id:'r5', ac:'#8822ff', label:'05',
    shapes:[ {n:46,t:5,l:26,w:38,layer:'hi',anim:'flick'}, {n:47,t:50,l:68,w:18,layer:'md',anim:'jump-r'}, {n:48,t:58,l:46,w:18,layer:'md',anim:'wink'}, ...brow([49,50,51,52,53,54]) ],
    frags:[ {t:3,l:3,txt:'SECTOR·05'},{t:8,l:68,txt:'ENCRYPTED — CLEARANCE REQUIRED'},{t:90,l:5,txt:'AES-256 / ATTEMPTS: ∞'},{t:44,l:28,txt:'⚿',op:.18},{t:65,l:52,txt:'CIPHER: ████████',op:.08} ],
    syms:[ {t:42,l:68,sz:26,sym:'g-orb',op:.22},{t:72,l:38,sz:18,sym:'g-arc',op:.12} ] },
  { id:'r6', ac:'#00aaaa', label:'06',
    shapes:[ {n:55,t:5,l:20,w:38,layer:'hi',anim:'flick'}, {n:56,t:48,l:62,w:18,layer:'md',anim:'wink'}, {n:57,t:58,l:42,w:18,layer:'md',anim:'jump'}, ...rcol([58,59,60,61,62,63]) ],
    frags:[ {t:3,l:3,txt:'SECTOR·06'},{t:8,l:62,txt:'DIAGNOSTIC — ANALYSIS ACTIVE'},{t:90,l:5,txt:'RANGE: ∞ m / VECTOR: LOCKED'},{t:44,l:22,txt:'◎',op:.16},{t:34,l:5,txt:'RES: MAX',op:.10} ],
    syms:[ {t:38,l:60,sz:24,sym:'g-hex',op:.20},{t:70,l:30,sz:18,sym:'g-arc',op:.12} ] },
  { id:'r7', ac:'#ddaa22', label:'07',
    shapes:[ {n:64,t:5,l:30,w:38,layer:'hi',anim:'flick'}, {n:65,t:50,l:4,w:18,layer:'md',anim:'jump-r'}, {n:66,t:42,l:70,w:18,layer:'md',anim:'wink'}, ...lcol([67,68,69,70,71,72]) ],
    frags:[ {t:3,l:3,txt:'SECTOR·07'},{t:8,l:70,txt:'TERMINUS — END OF SEQUENCE'},{t:90,l:14,txt:'BEYOND: UNKNOWN / DEPTH: MAX'},{t:44,l:32,txt:'∅ ∅ ∅',op:.18},{t:68,l:50,txt:'∅ ∅ ∅  END  ∅ ∅ ∅',op:.08} ],
    syms:[ {t:38,l:58,sz:24,sym:'g-prx',op:.18},{t:70,l:40,sz:18,sym:'g-hex',op:.12} ] },
];

// Icon rows: true = alive (blinks), false = invisible gap
const iconRows = [
  Array(15).fill(true),
  [true,true,true,true,true,true,true,true,true,true,true,false,true,false,true],
  [true,true,true,false,false,true,false,true,false,false,true,false,false,false,false],
];
// Quasi-random delays via golden-ratio distribution
const icoDelay = (ri: number, ci: number) =>
  (((ri * 7 + ci) * 0.618033 % 1) * 3.4).toFixed(2);
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>∅</title>
  <style>
    :root{--bg:#03050d;}
    *,*::before,*::after{margin:0;padding:0;box-sizing:border-box;}
    html,body{width:100%;height:100%;overflow:hidden;background:var(--bg);
              font-family:monospace;cursor:crosshair;}
    #c{position:fixed;inset:0;z-index:0;pointer-events:none;}
    #flash{position:fixed;inset:0;z-index:200;pointer-events:none;
           opacity:0;background:#000;transition:opacity .55s;}
    #tap{position:fixed;inset:0;z-index:100;}
    #back{position:fixed;z-index:300;bottom:.8rem;right:1.1rem;
          color:rgba(255,255,255,.05);font-size:10px;text-decoration:none;
          font-family:monospace;letter-spacing:.1em;transition:color .5s;}
    #back:hover{color:rgba(255,255,255,.32);}
    .rm{display:none;position:fixed;inset:0;z-index:10;overflow:hidden;}
    .rm.on{display:block;}

    /* ── Rooms 1-7 shape system ──────────── */
    .sh{position:absolute;pointer-events:none;display:block;}
    .sh-hi{opacity:.38;--op:.38;z-index:3;}
    .sh-md{opacity:.20;--op:.20;z-index:2;}
    .sh-sm{opacity:.14;--op:.14;z-index:1;}
    #r1 .sh{filter:brightness(0) invert(1) sepia(1) hue-rotate(177deg) saturate(8) brightness(.8);}
    #r2 .sh{filter:brightness(0) invert(1) sepia(1) hue-rotate(107deg) saturate(7) brightness(.7);}
    #r3 .sh{filter:brightness(0) invert(1) sepia(1) hue-rotate(317deg) saturate(7) brightness(.9);}
    #r4 .sh{filter:brightness(0) invert(1) sepia(1) hue-rotate(148deg) saturate(8) brightness(.8);}
    #r5 .sh{filter:brightness(0) invert(1) sepia(1) hue-rotate(230deg) saturate(9) brightness(.6);}
    #r6 .sh{filter:brightness(0) invert(1) sepia(1) hue-rotate(143deg) saturate(7) brightness(.7);}
    #r7 .sh{filter:brightness(0) invert(1) sepia(1) hue-rotate(7deg)   saturate(3) brightness(1.2);}
    .frag{position:absolute;font-size:9px;letter-spacing:.09em;color:var(--ac);opacity:.15;pointer-events:none;white-space:nowrap;}
    .sym{position:absolute;pointer-events:none;fill:none;stroke:var(--ac);stroke-width:.9;}
    .rid{position:absolute;bottom:10px;right:14px;font-size:9px;letter-spacing:.18em;color:var(--ac);opacity:.18;pointer-events:none;}

    /* ── Animations ──────────────────────── */
    @keyframes flick{0%,10%,12%,43%,47%,78%,83%,100%{opacity:var(--op,.38);}11%,44%,45%,79%,80%,81%,82%{opacity:0;}}
    @keyframes flick-fast{0%,6%,8%,26%,29%,53%,57%,100%{opacity:var(--op,.38);}7%,27%,28%,54%,55%,56%{opacity:0;}}
    @keyframes blink{0%,44%,56%,100%{opacity:var(--op,.14);}45%,55%{opacity:0;}}
    @keyframes wink{0%,50%,100%{opacity:var(--op,.20);}52%,94%{opacity:0;}}
    @keyframes jump{0%,32%{transform:translate(0,0);opacity:var(--op,.20);}33%{opacity:0;}33.3%{transform:translate(14vw,-9vh);opacity:0;}34%,65%{transform:translate(14vw,-9vh);opacity:var(--op,.20);}66%{opacity:0;}66.3%{transform:translate(-9vw,12vh);opacity:0;}67%,99%{transform:translate(-9vw,12vh);opacity:var(--op,.20);}99.4%{opacity:0;}99.7%{transform:translate(0,0);opacity:0;}100%{opacity:var(--op,.20);}}
    @keyframes jump-r{0%,32%{transform:translate(0,0);opacity:var(--op,.20);}33%{opacity:0;}33.3%{transform:translate(-12vw,8vh);opacity:0;}34%,65%{transform:translate(-12vw,8vh);opacity:var(--op,.20);}66%{opacity:0;}66.3%{transform:translate(8vw,-14vh);opacity:0;}67%,99%{transform:translate(8vw,-14vh);opacity:var(--op,.20);}99.4%{opacity:0;}99.7%{transform:translate(0,0);opacity:0;}100%{opacity:var(--op,.20);}}
    .flick{animation:flick 5.4s ease-in-out infinite;}
    .flick-fast{animation:flick-fast 3.6s ease-in-out infinite;}
    .blink{animation:blink 2.0s ease-in-out infinite;}
    .wink{animation:wink 6.5s ease-in-out infinite;}
    .jump{animation:jump 7.5s linear infinite;}
    .jump-r{animation:jump-r 8.5s linear infinite;}

    /* ══════════════════════════════════════
       ROOM 0 — CRT MONITOR THEME
    ══════════════════════════════════════ */
    #r0{background:#000;}

    /* Letterbox bars */
    .mon-bar{
      position:absolute;left:0;right:0;height:68px;
      background:#040407;z-index:30;
    }
    .mon-bar.top{top:0;}
    .mon-bar.btm{bottom:0;}
    .mon-lbl{
      position:absolute;font-size:8px;line-height:1.6;
      color:rgba(180,60,60,.45);letter-spacing:.05em;pointer-events:none;
    }

    /* Screen area */
    .mon-wrap{
      position:absolute;top:68px;bottom:68px;left:0;right:0;overflow:hidden;
    }
    @keyframes mon-flicker{
      0%,91%,100%{opacity:1;}
      92%{opacity:.96;}94%{opacity:.99;}96%{opacity:.93;}98%{opacity:.97;}
    }
    .mon-screen{
      position:absolute;inset:0;
      background:#050505;
      animation:mon-flicker 9s linear infinite;
    }
    .tc-bg{position:absolute;inset:0;width:100%;height:100%;z-index:1;display:block;}
    /* Scanlines */
    .mon-screen::before{
      content:'';position:absolute;inset:0;pointer-events:none;z-index:20;
      background:repeating-linear-gradient(
        0deg,transparent 0,transparent 3px,rgba(0,0,0,.16) 3px,rgba(0,0,0,.16) 4px
      );
    }
    /* Corner bracket markers */
    .mon-corner{
      position:absolute;width:22px;height:22px;z-index:22;
      border-color:rgba(160,185,255,.38);border-style:solid;
    }
    .mon-corner.tl{top:8px;left:10px;border-width:1px 0 0 1px;}
    .mon-corner.tr{top:8px;right:10px;border-width:1px 1px 0 0;}
    .mon-corner.bl{bottom:8px;left:10px;border-width:0 0 1px 1px;}
    .mon-corner.br{bottom:8px;right:10px;border-width:0 1px 1px 0;}
    .mon-corner::after{
      content:'+';position:absolute;font-size:8px;font-family:monospace;
      color:rgba(160,185,255,.3);
    }
    .mon-corner.tl::after{bottom:-6px;right:-4px;}
    .mon-corner.tr::after{bottom:-6px;left:-4px;}
    .mon-corner.bl::after{top:-6px;right:-4px;}
    .mon-corner.br::after{top:-6px;left:-4px;}

    /* Side decoration shapes — 2 fixed-size, red, top-left */
    .mon-deco{
      position:absolute;pointer-events:none;
      width:72px;height:72px;
      filter:brightness(0) invert(1) sepia(1) hue-rotate(323deg) saturate(22) brightness(1.05);
      z-index:5;
    }
    /* .bc は JS で直接 opacity を操作するので CSS 不要 */

    /* Red block noise canvas */
    #rn{position:absolute;inset:0;pointer-events:none;width:100%;height:100%;z-index:2;}
    /* Glitch canvas */
    #gc{position:absolute;inset:0;pointer-events:none;width:100%;height:100%;z-index:19;}

    /* Center console */
    .con{
      position:absolute;top:50%;left:50%;
      transform:translate(-50%,-50%);
      width:min(580px,68vw);
      background:rgba(6,6,12,.94);
      z-index:25;
    }
    .con-hdr{
      background:#cc3322;padding:5px 12px;
      font-size:10px;font-weight:bold;letter-spacing:.12em;
      color:#08080e;line-height:1.65;
    }
    .con-hdr span{display:block;font-weight:normal;opacity:.75;font-size:9px;}
    .con-body{
      padding:16px 20px;font-size:11.5px;
      color:#dd3322;letter-spacing:.08em;line-height:1.85;
    }
    .con-body p{margin:0;}
    .con-body .gap{height:.6em;}
    .con-icons{margin-top:10px;display:flex;flex-direction:column;gap:2px;}
    .ci-row{display:flex;gap:2px;}
    .ci{display:block;flex-shrink:0;}
    /* Icon perpetual irregular blink */
    @keyframes ico-blink{
      0%,12%,14%,42%,45%,67%,70%,87%,91%,100%{opacity:.72;}
      13%,43%,44%,68%,69%,88%,89%,90%         {opacity:0;}
    }
    .ci.alive{animation:ico-blink 3.4s linear infinite;}
  </style>
</head>
<body>
<canvas id="c"></canvas>
<div id="flash"></div>
<div id="tap"></div>
<a href={base} id="back">⌂</a>

<svg style="display:none" xmlns="http://www.w3.org/2000/svg">
<symbol id="g-orb" viewBox="0 0 48 48" fill="none" stroke="currentColor">
  <circle cx="24" cy="24" r="20" stroke-width=".9"/>
  <ellipse cx="24" cy="24" rx="20" ry="7.5" stroke-width=".75"/>
  <ellipse cx="24" cy="24" rx="7.5" ry="20" stroke-width=".75"/>
  <circle cx="24" cy="24" r="3" fill="currentColor" stroke="none"/>
  <line x1="24" y1="4"  x2="24" y2="8"  stroke-width=".7" opacity=".5"/>
  <line x1="24" y1="40" x2="24" y2="44" stroke-width=".7" opacity=".5"/>
  <line x1="4"  y1="24" x2="8"  y2="24" stroke-width=".7" opacity=".5"/>
  <line x1="40" y1="24" x2="44" y2="24" stroke-width=".7" opacity=".5"/>
</symbol>
<symbol id="g-prx" viewBox="0 0 48 48" fill="none" stroke="currentColor">
  <polygon points="24,3 45,24 24,45 3,24" stroke-width=".9"/>
  <polygon points="24,9 39,24 24,39 9,24" stroke-width=".8"/>
  <polygon points="24,16 32,24 24,32 16,24" stroke-width=".8"/>
  <line x1="24" y1="3"  x2="24" y2="16" stroke-width=".6" opacity=".4"/>
  <line x1="24" y1="32" x2="24" y2="45" stroke-width=".6" opacity=".4"/>
  <line x1="3"  y1="24" x2="16" y2="24" stroke-width=".6" opacity=".4"/>
  <line x1="32" y1="24" x2="45" y2="24" stroke-width=".6" opacity=".4"/>
  <rect x="22.5" y="22.5" width="3" height="3" fill="currentColor" stroke="none"/>
</symbol>
<symbol id="g-hex" viewBox="0 0 48 48" fill="none" stroke="currentColor">
  <polygon points="24,4 40,14 40,34 24,44 8,34 8,14" stroke-width=".9"/>
  <polygon points="24,12 34,17.5 34,30.5 24,36 14,30.5 14,17.5" stroke-width=".75"/>
  <line x1="24" y1="4"  x2="24" y2="12"   stroke-width=".6" opacity=".45"/>
  <line x1="40" y1="14" x2="34" y2="17.5" stroke-width=".6" opacity=".45"/>
  <line x1="40" y1="34" x2="34" y2="30.5" stroke-width=".6" opacity=".45"/>
  <line x1="24" y1="44" x2="24" y2="36"   stroke-width=".6" opacity=".45"/>
  <line x1="8"  y1="34" x2="14" y2="30.5" stroke-width=".6" opacity=".45"/>
  <line x1="8"  y1="14" x2="14" y2="17.5" stroke-width=".6" opacity=".45"/>
  <rect x="22.5" y="22.5" width="3" height="3" fill="currentColor" stroke="none"/>
</symbol>
<symbol id="g-arc" viewBox="0 0 48 48" fill="none" stroke="currentColor">
  <path d="M5,44 A39,39 0 0,1 44,5"  stroke-width=".9"/>
  <path d="M5,44 A27,27 0 0,1 32,17" stroke-width=".8"/>
  <path d="M5,44 A15,15 0 0,1 20,29" stroke-width=".8"/>
  <line x1="5" y1="44" x2="44" y2="5"  stroke-width=".6" opacity=".4"/>
  <line x1="5" y1="44" x2="32" y2="17" stroke-width=".6" opacity=".4"/>
  <line x1="5" y1="44" x2="20" y2="29" stroke-width=".6" opacity=".4"/>
  <rect x="3"  y="42" width="4" height="4" fill="currentColor" stroke="none"/>
  <rect x="2"  y="3"  width="4" height="4" stroke-width=".8"/>
  <rect x="42" y="2"  width="4" height="4" stroke-width=".8"/>
</symbol>
<!-- Crossed person figure for console icons -->
<symbol id="sp" viewBox="0 0 10 16" fill="none" stroke="currentColor">
  <circle cx="5" cy="2.5" r="1.8" stroke-width="1.2"/>
  <line x1="5" y1="4.3" x2="5" y2="10.5" stroke-width="1.2"/>
  <line x1="2" y1="7"   x2="8" y2="7"    stroke-width="1.2"/>
  <line x1="5" y1="10.5" x2="2.5" y2="15.5" stroke-width="1.2"/>
  <line x1="5" y1="10.5" x2="7.5" y2="15.5" stroke-width="1.2"/>
  <line x1=".8" y1=".5" x2="9.2" y2="15.5" stroke-width=".9"/>
  <line x1="9.2" y1=".5" x2=".8" y2="15.5" stroke-width=".9"/>
</symbol>
</svg>

<!-- Full-screen noise SVG — visible when r0 is active (position:fixed inside .rm) -->
<svg id="ns" aria-hidden="true"
     style="display:none;position:fixed;inset:0;z-index:95;pointer-events:none;width:100%;height:100%;overflow:hidden;">
  <defs>
    <filter id="nf" x="0" y="0" width="100%" height="100%" color-interpolation-filters="sRGB">
      <feTurbulence id="nft" type="turbulence" baseFrequency="0.70 0.18" numOctaves="3" seed="1" stitchTiles="stitch" result="noise"/>
      <feColorMatrix type="saturate" values="0" in="noise"/>
    </filter>
  </defs>
  <rect width="100%" height="100%" filter="url(#nf)" opacity="0.30" style="mix-blend-mode:overlay"/>
</svg>

<!-- ══════════════════════════════════════
     ROOM 0 — MONITOR / CRT THEME
══════════════════════════════════════ -->
<section class="rm on" id="r0">

  <!-- Top letterbox bar -->
  <div class="mon-bar top">
    <span class="mon-lbl" style="bottom:8px;left:16px">
      ⌀Ψ∅ΩΦ∇≈▒▓░⌀ // 0x4E4F58 // KERN.INIT.∅
    </span>
    <span class="mon-lbl" style="bottom:8px;left:50%;transform:translateX(-50%)">NOX</span>
    <span class="mon-lbl" style="bottom:8px;right:16px">v4.3.1</span>
  </div>

  <!-- Screen area -->
  <div class="mon-wrap">
    <div class="mon-screen">

      <!-- Test-card background canvas -->
      <canvas id="tc" class="tc-bg" aria-hidden="true"></canvas>

      <!-- Red block noise canvas -->
      <canvas id="rn" aria-hidden="true"></canvas>

      <!-- Glitch canvas -->
      <canvas id="gc" aria-hidden="true"></canvas>

      <!-- Corner markers -->
      <div class="mon-corner tl"></div>
      <div class="mon-corner tr"></div>
      <div class="mon-corner bl"></div>
      <div class="mon-corner br"></div>

      <!-- Top-left decorations: 2 shapes, fixed 72px, red, no transparency -->
      <img class="mon-deco" src={`${base}/svg/Shape%201.svg`} style="top:14px;left:14px;"  aria-hidden="true"/>
      <img class="mon-deco" src={`${base}/svg/Shape%207.svg`} style="top:14px;left:96px;"  aria-hidden="true"/>

      <!-- Centre console panel -->
      <div class="con">
        <div class="con-hdr">
          SECTOR·00 // FILE LOOKUP
          <span>VERSION: 4.3.1</span>
        </div>
        <div class="con-body">
          <p>FILE: NOX.KLR-0000.R.00001</p>
          <p>FILE DATE: XXXX-XX-XX</p>
          <div class="gap"></div>
          <p>TARGET: ∅</p>
          <p>CLEARANCE: RESTRICTED [LEVEL 7+]</p>
          <p>ENCRYPTION: AES-256 [HASH: 0xCC9911]</p>
          <div class="gap"></div>
          <p>NODE STATUS: UNRESOLVED — 0 / 8 ACTIVE</p>
          <p>SIGNAL DEPTH: ∞</p>
          <div class="gap"></div>
          <p>SEE FULL RECORD FOR NAVIGATION DETAILS</p>
          <p>[RESTRICTED ACCESS] [ENCRYPTION: AES-256]</p>
          <div class="con-icons">
            {iconRows.map((row, ri) => (
              <div class="ci-row">
                {row.map((alive, ci) => (
                  <svg class:list={['ci', alive && 'alive']}
                       width="13" height="19"
                       style={`color:#dd3322;opacity:${alive?.72:0};animation-delay:${icoDelay(ri,ci)}s`}
                       aria-hidden="true">
                    <use href="#sp"/>
                  </svg>
                ))}
              </div>
            ))}
          </div>
        </div>
      </div>

    </div><!-- .mon-screen -->
  </div><!-- .mon-wrap -->

  <!-- Bottom letterbox bar -->
  <div class="mon-bar btm">
    <span class="mon-lbl" style="top:8px;left:16px;line-height:1.7">
      精度のソース<br>
      精製のインターフェード　推進機の設定<br>
      SDV/TV 56&nbsp;&nbsp;&nbsp;スライドを見る .00%
    </span>
    <span class="mon-lbl" style="top:8px;left:50%;transform:translateX(-50%)">NOX</span>
    <span class="mon-lbl" style="top:8px;right:16px">∅ ∅ ∅</span>
  </div>

</section>

<!-- ══════════════════════════════════════
     ROOMS 1-7 (data-driven)
══════════════════════════════════════ -->
{rooms.map(room => (
  <section class="rm" id={room.id} style={`--ac:${room.ac}`}>
    {room.shapes.map(s => (
      <img class:list={['sh',`sh-${s.layer}`,s.anim]} src={`${base}/svg/Shape%20${s.n}.svg`}
           style={`top:${s.t}%;left:${s.l}%;width:${s.w}%${s.delay?`;animation-delay:${s.delay}s`:''}`}
           aria-hidden="true"/>
    ))}
    {room.frags.map(f => (
      <span class="frag" style={`top:${f.t}%;left:${f.l}%${f.op!==undefined?`;opacity:${f.op}`:''}`}>{f.txt}</span>
    ))}
    {room.syms.map(s => (
      <svg class="sym" width={s.sz} height={s.sz}
           style={`top:${s.t}%;left:${s.l}%;opacity:${s.op??.15};color:var(--ac)`} aria-hidden="true">
        <use href={`#${s.sym}`}/>
      </svg>
    ))}
    <span class="rid">{room.label} / 07</span>
  </section>
))}

<script>
'use strict';

/* ── Background grid canvas ── */
const canvas=document.getElementById('c');
const ctx=canvas.getContext('2d');
let W,H;
function resize(){W=canvas.width=window.innerWidth;H=canvas.height=window.innerHeight;}
resize();window.addEventListener('resize',resize);
function frame(t){
  ctx.clearRect(0,0,W,H);
  ctx.strokeStyle='rgba(18,38,80,.07)';ctx.lineWidth=.5;
  const g=32;
  for(let x=g;x<W;x+=g){ctx.beginPath();ctx.moveTo(x,0);ctx.lineTo(x,H);ctx.stroke();}
  for(let y=g;y<H;y+=g){ctx.beginPath();ctx.moveTo(0,y);ctx.lineTo(W,y);ctx.stroke();}
  requestAnimationFrame(frame);
}
requestAnimationFrame(frame);

/* ── Room 0: test-card background ── */
const tc=document.getElementById('tc');
function drawTestCard(){
  if(!tc)return;
  const W=tc.width=tc.offsetWidth||window.innerWidth;
  const H=tc.height=tc.offsetHeight||window.innerHeight;
  const dc=tc.getContext('2d');

  // Graduation bands (thin horizontal lines in center)
  dc.strokeStyle='rgba(180,180,180,.11)'; dc.lineWidth=.4;
  [H*.28,H*.32,H*.36,H*.40].forEach(hy=>{
    dc.beginPath(); dc.moveTo(W*.27,hy); dc.lineTo(W*.73,hy); dc.stroke();
  });

  // Ruler line at ~43.5%
  const ry=H*.435;
  dc.strokeStyle='rgba(230,230,230,.55)'; dc.lineWidth=.8;
  dc.beginPath(); dc.moveTo(W*.28,ry); dc.lineTo(W*.72,ry); dc.stroke();
  dc.strokeStyle='rgba(200,200,200,.17)'; dc.lineWidth=.5;
  dc.beginPath(); dc.moveTo(0,ry); dc.lineTo(W*.28,ry);
  dc.moveTo(W*.72,ry); dc.lineTo(W,ry); dc.stroke();
  // Tick marks
  dc.strokeStyle='rgba(215,215,215,.33)'; dc.lineWidth=.5;
  const ts=W*.022;
  for(let tx=0;tx<W;tx+=ts){
    const maj=Math.round(tx/ts)%5===0;
    const th=maj?7:3.5;
    dc.beginPath(); dc.moveTo(tx,ry-th); dc.lineTo(tx,ry+th); dc.stroke();
  }

  // Bullseye crosshair at centre of ruler
  const bx=W*.5,byc=ry;
  dc.strokeStyle='rgba(230,230,230,.50)'; dc.lineWidth=.75;
  dc.beginPath(); dc.arc(bx,byc,H*.043,0,Math.PI*2); dc.stroke();
  dc.beginPath(); dc.arc(bx,byc,H*.018,0,Math.PI*2); dc.stroke();
  const ao=H*.043,ae=H*.062;
  dc.beginPath();
  dc.moveTo(bx-ae,byc); dc.lineTo(bx-ao,byc);
  dc.moveTo(bx+ao,byc); dc.lineTo(bx+ae,byc);
  dc.moveTo(bx,byc-ae); dc.lineTo(bx,byc-ao);
  dc.moveTo(bx,byc+ao); dc.lineTo(bx,byc+ae);
  dc.stroke();
  dc.fillStyle='rgba(230,230,230,.65)'; dc.fillRect(bx-2.5,byc-2.5,5,5);
  dc.strokeStyle='rgba(230,230,230,.50)'; dc.lineWidth=.6;
  dc.strokeRect(bx-5,byc-5,10,10);

  // Text near ruler
  dc.font='bold 9.5px monospace'; dc.fillStyle='rgba(220,220,220,.65)';
  dc.fillText('-2',bx-W*.20,ry-7);
  dc.fillText('TEST',bx-W*.11,ry-7);
  dc.fillText('FSTEST',bx+W*.05,ry-7);

  // Error text (left zone)
  dc.font='7.5px monospace'; dc.fillStyle='rgba(165,165,165,.38)';
  dc.fillText('err: ERROR CODE 045 · 0x7F/011',W*.07,H*.31);
  dc.fillText('↓ HII⁰',W*.09,H*.335);
  dc.fillText('REBOOT/PROTOCOL',W*.07,H*.37);
  dc.fillText('##  ATTEMPT 001',W*.07,H*.40);

  // Right label "01"
  dc.font='bold 26px monospace'; dc.fillStyle='rgba(210,210,210,.50)';
  dc.fillText('01',W*.905,H*.60);

  // Bottom label row
  const bly=H*.715;
  dc.font='8px monospace'; dc.fillStyle='rgba(185,185,185,.45)';
  ['·KR','R','T+','R','__L1'].forEach((t,i)=>{
    dc.fillText(t,[W*.33,W*.41,W*.445,W*.47,W*.50][i],bly);
  });

  // Dot indicators ● ○ ● ○
  const dotY=H*.72;
  [[W*.625,true],[W*.66,false],[W*.698,true],[W*.735,false]].forEach(([dx,fill])=>{
    dc.beginPath(); dc.arc(dx,dotY,4,0,Math.PI*2);
    dc.strokeStyle='rgba(185,185,185,.55)'; dc.lineWidth=.8;
    if(fill){dc.fillStyle='rgba(185,185,185,.55)';dc.fill();}
    else dc.stroke();
  });

  // Small horizontal calibration lines
  dc.strokeStyle='rgba(180,180,180,.20)'; dc.lineWidth=.55;
  [[H*.630,W*.30,W*.44],[H*.641,W*.42,W*.50],[H*.625,W*.50,W*.60]].forEach(([y,x1,x2])=>{
    dc.beginPath(); dc.moveTo(x1,y); dc.lineTo(x2,y); dc.stroke();
  });
  // Vertical calibration ticks below ruler
  dc.strokeStyle='rgba(180,180,180,.17)'; dc.lineWidth=.55;
  [W*.30,W*.44,W*.56,W*.70].forEach(vx=>{
    dc.beginPath(); dc.moveTo(vx,H*.62); dc.lineTo(vx,H*.68); dc.stroke();
  });

  // Left-edge blocks
  [[H*.54,H*.09],[H*.65,H*.06],[H*.73,H*.04]].forEach(([y,h])=>{
    dc.fillStyle='#0f0f0f'; dc.fillRect(0,y,W*.025,h);
    dc.strokeStyle='rgba(130,130,130,.18)'; dc.lineWidth=.4;
    dc.strokeRect(0,y,W*.025,h);
  });
  // Right-edge blocks
  [[H*.54,H*.09],[H*.65,H*.06],[H*.73,H*.04]].forEach(([y,h])=>{
    dc.fillStyle='#0f0f0f'; dc.fillRect(W*.975,y,W*.025,h);
    dc.strokeStyle='rgba(130,130,130,.18)'; dc.lineWidth=.4;
    dc.strokeRect(W*.975,y,W*.025,h);
  });

  // Bottom-left halftone dot block
  const hlW=W*.20,hlH=H*.26,hlX=0,hlY=H*.74;
  dc.fillStyle='#090909'; dc.fillRect(hlX,hlY,hlW,hlH);
  const dsX=hlW/15,dsY=hlH/10;
  for(let dy=hlY+dsY*.5;dy<hlY+hlH;dy+=dsY){
    for(let dx=hlX+dsX*.5;dx<hlX+hlW;dx+=dsX){
      const a=(.07+(dx-hlX)/hlW*.72).toFixed(2);
      dc.fillStyle=`rgba(118,118,118,${a})`;
      dc.beginPath(); dc.arc(dx,dy,2.5,0,Math.PI*2); dc.fill();
    }
  }
  // Bottom-right halftone dot block
  const hrW=W*.18,hrH=H*.22,hrX=W*.82,hrY=H*.78;
  dc.fillStyle='#0c0c0c'; dc.fillRect(hrX,hrY,hrW,hrH);
  for(let dy=hrY+dsY*.5;dy<hrY+hrH;dy+=dsY){
    for(let dx=hrX+dsX*.5;dx<hrX+hrW;dx+=dsX){
      const a=(.07+(1-(dx-hrX)/hrW)*.65).toFixed(2);
      dc.fillStyle=`rgba(125,125,125,${a})`;
      dc.beginPath(); dc.arc(dx,dy,2.5,0,Math.PI*2); dc.fill();
    }
  }

  // Fine grid overlay
  dc.strokeStyle='rgba(180,180,180,.020)'; dc.lineWidth=.3;
  const gs=H*.04;
  for(let gy=gs;gy<H;gy+=gs){dc.beginPath();dc.moveTo(0,gy);dc.lineTo(W,gy);dc.stroke();}
  for(let gx=gs*2;gx<W;gx+=gs*2){dc.beginPath();dc.moveTo(gx,0);dc.lineTo(gx,H);dc.stroke();}

  // Asterisk/arrow markers at bottom
  dc.font='9px monospace'; dc.fillStyle='rgba(175,175,175,.28)';
  dc.fillText('✱ ✱ ✱',W*.37,H*.835);
  dc.fillText('→ →',W*.56,H*.825);
}
drawTestCard();
window.addEventListener('resize',drawTestCard);

/* ── Room 0: animated red block noise ── */
const rn=document.getElementById('rn');
function drawRedNoise(){
  if(!rn||!document.getElementById('r0').classList.contains('on'))return;
  const W=rn.width=rn.offsetWidth;
  const H=rn.height=rn.offsetHeight;
  const rx=rn.getContext('2d');
  rx.clearRect(0,0,W,H);
  const count=6+Math.random()*10|0;
  for(let i=0;i<count;i++){
    const x=Math.random()*W;
    const y=Math.random()*H;
    const w=4+Math.random()*140;
    const h=2+Math.random()*6;
    const r=150+Math.random()*105|0;
    rx.fillStyle=`rgb(${r},0,0)`;
    rx.fillRect(x,y,w,h);
  }
  setTimeout(()=>rn.getContext('2d').clearRect(0,0,rn.width,rn.height),
             120+Math.random()*200);
}
(function scheduleRed(){
  setTimeout(()=>{drawRedNoise();scheduleRed();},1800+Math.random()*2600);
})();

/* ── Room 0: SVG turbulence noise ── */
const nft = document.getElementById('nft');
const ns  = document.getElementById('ns');
let nSeed = 1;
function animNoise(){
  nSeed = (nSeed % 200) + 1;
  if(nft) nft.setAttribute('seed', nSeed);
}
setInterval(animNoise, 55); // ~18fps grain animation

// Show/hide noise overlay with room
function syncNoise(){
  if(ns) ns.style.display = document.getElementById('r0').classList.contains('on') ? '' : 'none';
}
syncNoise();

/* ── Room 0: console text irregular blink ── */
function blinkConChars(){
  const r0 = document.getElementById('r0');
  if(!r0 || !r0.classList.contains('on')) return;
  const paras = [...document.querySelectorAll('#r0 .con-body p')];
  const ok = paras.filter(p => !p.querySelector('.bc') && p.textContent.trim().length > 3);
  if(!ok.length) return;

  const p   = ok[Math.floor(Math.random() * ok.length)];
  const txt = p.textContent;
  const s   = Math.floor(Math.random() * Math.max(0, txt.length - 4));
  const len = 1 + Math.floor(Math.random() * 5);

  const span = document.createElement('span');
  span.className = 'bc';
  span.textContent = txt.slice(s, s + len);
  p.textContent = '';
  p.appendChild(document.createTextNode(txt.slice(0, s)));
  p.appendChild(span);
  p.appendChild(document.createTextNode(txt.slice(s + len)));

  // Random blink pattern: 1–3 blinks, each with random on/off durations
  let t = 8 + Math.random() * 45;
  const n = 1 + Math.floor(Math.random() * 3);
  for(let i = 0; i < n; i++){
    const offDur = 22 + Math.random() * 110; // off time varies wildly
    const gap    = Math.random() * 90;       // pre-blink random pause
    t += gap;
    (function(T, D){
      setTimeout(() => { if(span.parentNode) span.style.opacity = '0'; }, T);
      setTimeout(() => { if(span.parentNode) span.style.opacity = '1'; }, T + D);
    })(t, offDur);
    t += offDur + 12 + Math.random() * 55;
  }
  setTimeout(() => { if(p.contains && p.contains(span)) p.textContent = txt; }, t + 40);
}

// 4 independent threads — different base speeds, random skip rate
[
  {base:60,  spread:280, skip:.25},
  {base:130, spread:450, skip:.20},
  {base:220, spread:680, skip:.30},
  {base:380, spread:950, skip:.15},
].forEach(({base, spread, skip}, i) => {
  setTimeout(function run(){
    if(Math.random() >= skip) blinkConChars();
    setTimeout(run, base + Math.random() * spread);
  }, i * 55 + Math.random() * 120);
});

/* ── Room 0: occasional horizontal glitch ── */
const gc=document.getElementById('gc');
function doGlitch(){
  if(!gc||!document.getElementById('r0').classList.contains('on'))return;
  gc.width=gc.offsetWidth;gc.height=gc.offsetHeight;
  const gx=gc.getContext('2d');
  if(Math.random()<.45){
    const y=Math.random()*gc.height;
    const h=Math.random()*4+1;
    const x=Math.random()*gc.width*.5;
    const w=Math.random()*gc.width*.4+80;
    const r=180+Math.random()*75|0,gg=Math.random()*40|0,b=Math.random()*40|0;
    gx.fillStyle=`rgba(${r},${gg},${b},${.08+Math.random()*.18})`;
    gx.fillRect(x,y,w,h);
  }
  setTimeout(()=>{ if(gc)gc.getContext('2d').clearRect(0,0,gc.width,gc.height); },
             60+Math.random()*140);
}
setInterval(doGlitch,900+Math.random()*1400);

/* ── Navigation ── */
let cur=0,busy=false;
const N=8;
const flash=document.getElementById('flash');
function go(n){
  n=((n%N)+N)%N;
  if(busy||n===cur)return;
  busy=true;
  flash.style.transition='none';flash.style.opacity='.82';
  setTimeout(()=>{
    document.querySelectorAll('.rm').forEach(r=>r.classList.remove('on'));
    document.getElementById('r'+n).classList.add('on');
    cur=n;
    syncNoise();
    flash.style.transition='opacity .6s';flash.style.opacity='0';
    setTimeout(()=>{busy=false;},680);
  },80);
}
document.getElementById('tap').addEventListener('click',e=>{
  if(busy)return;
  if(e.shiftKey)go(cur-1);else go(cur+1);
});
document.addEventListener('keydown',e=>{
  if(e.key==='ArrowRight'||e.key===' '||e.key==='Enter')go(cur+1);
  if(e.key==='ArrowLeft'||e.key==='Backspace')go(cur-1);
});
</script>
</body>
</html>
