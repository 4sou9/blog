<script>
'use strict';
// maze: 0→[1,2] 1→[3,4] 2→[4,5] 3→[6,1] 4→[5,7] 5→[7,0] 6→[0,3] 7→[2,5]

// canvas bg
const canvas = document.getElementById('c');
const ctx    = canvas.getContext('2d');
let W, H;
function resize() { W = canvas.width = window.innerWidth; H = canvas.height = window.innerHeight; }
resize(); window.addEventListener('resize', resize);
function frame(t) {
  ctx.clearRect(0,0,W,H);
  ctx.strokeStyle='rgba(18,38,80,.13)'; ctx.lineWidth=.5;
  const g=40;
  for(let x=g;x<W;x+=g){ctx.beginPath();ctx.moveTo(x,0);ctx.lineTo(x,H);ctx.stroke();}
  for(let y=g;y<H;y+=g){ctx.beginPath();ctx.moveTo(0,y);ctx.lineTo(W,y);ctx.stroke();}
  const sy=(t*.022)%H;
  const sl=ctx.createLinearGradient(0,sy-55,0,sy+55);
  sl.addColorStop(0,'rgba(255,255,255,0)');
  sl.addColorStop(.5,'rgba(255,255,255,.018)');
  sl.addColorStop(1,'rgba(255,255,255,0)');
  ctx.fillStyle=sl; ctx.fillRect(0,sy-55,W,110);
  requestAnimationFrame(frame);
}
requestAnimationFrame(frame);

// navigation
let cur=0, busy=false;
const flash=document.getElementById('flash');
function go(n) {
  if(busy||n===cur) return; busy=true;
  flash.style.transition='none'; flash.style.opacity='1';
  setTimeout(()=>{
    document.querySelectorAll('.rm').forEach(r=>r.classList.remove('on'));
    document.getElementById(`r${n}`).classList.add('on');
    cur=n;
    flash.style.transition='opacity 0.42s'; flash.style.opacity='0';
    setTimeout(()=>{busy=false;},470);
  },130);
}
document.addEventListener('click', e=>{
  if(busy) return;
  const b=e.target.closest('[data-to]');
  if(b) go(parseInt(b.dataset.to));
});

// clock
const start=Date.now();
function pad(n){return String(n).padStart(2,'0');}
function tick(){
  const d=new Date(), now=Date.now();
  const ts=`${pad(d.getHours())}:${pad(d.getMinutes())}:${pad(d.getSeconds())}`;
  const el=Math.floor((now-start)/1000);
  const em=`T+ ${pad(Math.floor(el/60))}:${pad(el%60)}`;
  for(let i=0;i<8;i++){
    const c=document.getElementById(`k${i}`); if(c) c.textContent=ts;
    const e=document.getElementById(`e${i}`); if(e) e.textContent=em;
  }
}
tick(); setInterval(tick,1000);

// encrypted display for R5
const EC='ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/=';
const el5=document.getElementById('enc5');
if(el5) setInterval(()=>{el5.textContent=Array.from({length:60},()=>EC[Math.floor(Math.random()*EC.length)]).join('');},160);
</script>
