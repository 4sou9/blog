---
import Base from '../layouts/Base.astro';
import { formatDate, listedPosts } from '../lib/posts';

const base = import.meta.env.BASE_URL;
const posts = await listedPosts();
---
<Base>
  <ol class="post-list">
    {posts.map((post) => (
      <li>
        <div class="post-date">{formatDate(post.data.pubDate)}</div>
        <a class="post-title" href={`${base}/${post.id}`}>{post.data.title}</a>
      </li>
    ))}
  </ol>
</Base>
