---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const base = import.meta.env.BASE_URL;
const posts = (await getCollection('blog'))
  .filter((p) => !p.data.unlisted)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const fmt = (d) =>
  `${d.getFullYear()}年${String(d.getMonth() + 1).padStart(2, '0')}月${String(d.getDate()).padStart(2, '0')}日`;
---
<Base>
  <ol class="post-list">
    {posts.map((post) => (
      <li>
        <div class="post-date">{fmt(post.data.pubDate)}</div>
        <a class="post-title" href={`${base}/${post.id}`}>{post.data.title}</a>
      </li>
    ))}
  </ol>
</Base>
