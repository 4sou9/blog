---
import { getCollection } from 'astro:content';
import { textExcerpt } from '../plugins/remark-excerpt.js';

const base = import.meta.env.BASE_URL;
const posts = (await getCollection('blog'))
  .filter((p) => !p.data.unlisted)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>OGP Preview</title>
    <meta name="robots" content="noindex" />
    <style>
      body { background: #111; color: #ccc; font-family: sans-serif; padding: 2rem; margin: 0; }
      h1 { font-size: 1.2rem; margin-bottom: 1.5rem; }
      .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 1.5rem; }
      .card a { display: block; text-decoration: none; color: inherit; }
      .card img { width: 100%; aspect-ratio: 1200/630; display: block; border-radius: 6px; }
      .card .title { font-size: 0.8rem; margin-top: 0.4rem; opacity: 0.7; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
      .card .desc { font-size: 0.75rem; margin-top: 0.2rem; opacity: 0.5; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
    </style>
  </head>
  <body>
    <h1>OGP Preview</h1>
    <div class="grid">
      <div class="card">
        <a href={`${base}/og-image.svg`} target="_blank">
          <img src={`${base}/og-image.svg`} alt="サイトトップ" />
          <div class="title">サイトトップ</div>
          <div class="desc">備忘録です</div>
        </a>
      </div>
      {posts.map((post) => {
        const desc = post.data.description ?? textExcerpt(post.body);
        return (
          <div class="card">
            <a href={`${base}/og/${post.id}.png`} target="_blank">
              <img src={`${base}/og/${post.id}.png`} alt={post.data.title} />
              <div class="title">{post.data.title}</div>
              {desc && <div class="desc">{desc}</div>}
            </a>
          </div>
        );
      })}
    </div>
  </body>
</html>
