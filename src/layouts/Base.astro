---
import '../styles/global.css';
const SITE_TITLE = 'ねこのメモ';
const SITE_DESCRIPTION = '日々の技術メモや気になったことを書き留めるブログ。';
const base = import.meta.env.BASE_URL;
const { title, description } = Astro.props;
const pageTitle = title ? `${title} - ${SITE_TITLE}` : SITE_TITLE;
const pageDescription = description ?? SITE_DESCRIPTION;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <meta name="description" content={pageDescription} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:type" content={title ? 'article' : 'website'} />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={new URL(`${base}/og-image.svg`, Astro.site)} />
  </head>
  <body>
    <header class="site-title"><a href={base}>{SITE_TITLE}</a></header>
    <main><slot /></main>
  </body>
</html>
