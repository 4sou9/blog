---
import '../styles/global.css';
const SITE_TITLE = 'ねこのメモ';
const SITE_DESCRIPTION = '備忘録です';
const base = import.meta.env.BASE_URL;
const { title, description, slug } = Astro.props;
const isHome = Astro.url.pathname === `${base}/` || Astro.url.pathname === base;
const pageTitle = title ? `${title} - ${SITE_TITLE}` : SITE_TITLE;
const pageDescription = description ?? SITE_DESCRIPTION;
const ogImage = slug
  ? new URL(`${base}/og/${slug}.png`, Astro.site)
  : new URL(`${base}/og-image.svg`, Astro.site);
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <link rel="icon" href={`${base}/favicon.ico`} sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="icon" type="image/png" sizes="16x16" href={`${base}/favicon-16x16.png`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}/favicon-32x32.png`} />
    <link rel="icon" type="image/png" sizes="96x96" href={`${base}/favicon-96x96.png`} />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}/site.webmanifest`} />
    <link rel="alternate" type="application/rss+xml" title="ねこのメモ" href={`${base}/rss.xml`} />
    <meta name="description" content={pageDescription} />
    <style>html{background:#36373e}</style>
    <link rel="stylesheet" href={`${base}/pagefind/pagefind-ui.css`} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:type" content={title ? 'article' : 'website'} />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <header class="site-header">
      <div class="site-title">{isHome ? SITE_TITLE : <a href={base}>{SITE_TITLE}</a>}</div>
      <div id="search" class="site-search"></div>
    </header>
    <main><slot /></main>
    <script>
      document.querySelectorAll('.prose pre').forEach((pre) => {
        const wrapper = document.createElement('div');
        wrapper.className = 'code-wrapper';
        pre.parentNode.insertBefore(wrapper, pre);
        wrapper.appendChild(pre);

        const lang = pre.getAttribute('data-language');
        if (lang) {
          const label = document.createElement('span');
          label.className = 'code-lang';
          label.textContent = lang;
          wrapper.appendChild(label);
          pre.style.paddingTop = '2rem';
        }

        const btn = document.createElement('button');
        btn.className = 'copy-btn';
        btn.textContent = 'copy';
        btn.addEventListener('click', () => {
          navigator.clipboard.writeText(pre.querySelector('code')?.textContent ?? pre.textContent ?? '');
          btn.textContent = 'copied!';
          setTimeout(() => { btn.textContent = 'copy'; }, 2000);
        });
        wrapper.appendChild(btn);
      });

      // タブ切り替え（:::tabs / :::tab）
      document.querySelectorAll('.tabs').forEach((tabs) => {
        const btns = tabs.querySelectorAll(':scope > .tab-list > .tab-btn');
        const panels = tabs.querySelectorAll(':scope > .tab-panel');
        btns.forEach((btn) => {
          btn.addEventListener('click', () => {
            const i = Number(btn.dataset.index);
            btns.forEach((b, j) => b.classList.toggle('active', j === i));
            panels.forEach((p, j) => p.classList.toggle('active', j === i));
          });
        });
      });
    </script>
    <script is:inline src={`${base}/pagefind/pagefind-ui.js`}></script>
    <script is:inline define:vars={{ base }}>
      window.addEventListener('DOMContentLoaded', () => {
        if (!window.PagefindUI) return;
        const fix = (u) => (u && !u.startsWith(base + '/')) ? base + (u.startsWith('/') ? '' : '/') + u : u;
        new window.PagefindUI({
          element: '#search',
          bundlePath: base + '/pagefind/',
          showImages: false,
          showSubResults: true,
          pageSize: 5,
          processResult: (result) => {
            result.url = fix(result.url);
            if (Array.isArray(result.sub_results)) result.sub_results.forEach((s) => { s.url = fix(s.url); });
            return result;
          },
          translations: { placeholder: 'Search', zero_results: '「[SEARCH_TERM]」に一致する記事がありません' },
        });
      });
    </script>
  </body>
</html>
