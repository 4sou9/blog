---
import '../styles/global.css';
const SITE_TITLE = 'ねこのメモ';
const SITE_DESCRIPTION = '備忘録です';
const base = import.meta.env.BASE_URL;
const { title, description, slug } = Astro.props;
const isHome = Astro.url.pathname === `${base}/` || Astro.url.pathname === base;
const pageTitle = title ? `${title} - ${SITE_TITLE}` : SITE_TITLE;
const pageDescription = description ?? SITE_DESCRIPTION;
const ogImage = slug
  ? new URL(`${base}/og/${slug}.png`, Astro.site)
  : new URL(`${base}/og-image.svg`, Astro.site);
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <link rel="icon" href={`${base}/favicon.ico`} sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="icon" type="image/png" sizes="16x16" href={`${base}/favicon-16x16.png`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}/favicon-32x32.png`} />
    <link rel="icon" type="image/png" sizes="96x96" href={`${base}/favicon-96x96.png`} />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}/site.webmanifest`} />
    <link rel="alternate" type="application/rss+xml" title="ねこのメモ" href={`${base}/rss.xml`} />
    <meta name="description" content={pageDescription} />
    <style>html{background:#36373e}</style>
    <link rel="stylesheet" href={`${base}/pagefind/pagefind-ui.css`} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:type" content={title ? 'article' : 'website'} />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <header class="site-header">
      <div class="site-title">{isHome ? SITE_TITLE : <a href={base}>{SITE_TITLE}</a>}</div>
      <button id="search-trigger" class="search-trigger" type="button" aria-label="検索を開く">
        <svg class="search-trigger__icon" width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path fill="currentColor" d="M12.75 11.26h-.79l-.28-.27a6.47 6.47 0 1 0-.7.7l.27.28v.79l5 4.99 1.49-1.49-5-4.99Zm-6 0a4.5 4.5 0 1 1 0-9 4.5 4.5 0 0 1 0 9Z"/></svg>
      </button>
    </header>
    <main><slot /></main>
    <div id="search-modal" class="search-modal" hidden>
      <div class="search-modal__panel" role="dialog" aria-modal="true" aria-label="サイト内検索">
        <div class="search-modal__head">
          <div id="search" class="site-search"></div>
          <button class="search-modal__close" type="button" data-close aria-label="閉じる">✕</button>
        </div>
      </div>
    </div>
    <script>
      document.querySelectorAll('.prose pre').forEach((pre) => {
        const wrapper = document.createElement('div');
        wrapper.className = 'code-wrapper';
        pre.parentNode.insertBefore(wrapper, pre);
        wrapper.appendChild(pre);

        const lang = pre.getAttribute('data-language');
        if (lang) {
          const label = document.createElement('span');
          label.className = 'code-lang';
          label.textContent = lang;
          wrapper.appendChild(label);
          pre.style.paddingTop = '2rem';
        }

        const btn = document.createElement('button');
        btn.className = 'copy-btn';
        btn.textContent = 'copy';
        btn.addEventListener('click', () => {
          navigator.clipboard.writeText(pre.querySelector('code')?.textContent ?? pre.textContent ?? '');
          btn.textContent = 'copied!';
          setTimeout(() => { btn.textContent = 'copy'; }, 2000);
        });
        wrapper.appendChild(btn);
      });

      // タブ切り替え（:::tabs / :::tab）
      document.querySelectorAll('.tabs').forEach((tabs) => {
        const btns = tabs.querySelectorAll(':scope > .tab-list > .tab-btn');
        const panels = tabs.querySelectorAll(':scope > .tab-panel');
        btns.forEach((btn) => {
          btn.addEventListener('click', () => {
            const i = Number(btn.dataset.index);
            btns.forEach((b, j) => b.classList.toggle('active', j === i));
            panels.forEach((p, j) => p.classList.toggle('active', j === i));
          });
        });
      });
    </script>
    <script is:inline src={`${base}/pagefind/pagefind-ui.js`}></script>
    <script is:inline define:vars={{ base }}>
      window.addEventListener('DOMContentLoaded', () => {
        const trigger = document.getElementById('search-trigger');
        const modal = document.getElementById('search-modal');
        if (!trigger || !modal) return;

        let initialized = false;
        const initOnce = () => {
          if (initialized || !window.PagefindUI) return;
          initialized = true;
          const fix = (u) => (u && !u.startsWith(base + '/')) ? base + (u.startsWith('/') ? '' : '/') + u : u;
          new window.PagefindUI({
            element: '#search',
            bundlePath: base + '/pagefind/',
            showImages: false,
            showSubResults: true,
            pageSize: 5,
            processResult: (result) => {
              result.url = fix(result.url);
              if (Array.isArray(result.sub_results)) result.sub_results.forEach((s) => { s.url = fix(s.url); });
              return result;
            },
            translations: { placeholder: '記事を検索', zero_results: '「[SEARCH_TERM]」に一致する記事がありません' },
          });
          // Pagefind の入力欄は name/id を持たず autocomplete も無いため、ブラウザが
          // 用途を判別できずパスワード/オートフィルを促す。検索用フィールドだと明示する
          const input = document.querySelector('#search .pagefind-ui__search-input');
          if (input) {
            input.setAttribute('type', 'search');
            input.setAttribute('name', 'site-search');
            input.setAttribute('autocomplete', 'off');
            input.setAttribute('autocapitalize', 'off');
            input.setAttribute('autocorrect', 'off');
            input.setAttribute('spellcheck', 'false');
            input.setAttribute('enterkeyhint', 'search');
            input.setAttribute('aria-label', '記事を検索');
          }
        };

        const open = () => {
          if (!window.PagefindUI) return;
          modal.hidden = false;
          document.body.style.overflow = 'hidden';
          // iOS はユーザー操作と同じ呼び出しスタック内で同期的に focus しないとソフト
          // キーボードが開かない。input を事前生成済みなので rAF を挟まず同期で focus する
          modal.querySelector('.pagefind-ui__search-input')?.focus();
        };
        const close = () => {
          modal.hidden = true;
          document.body.style.overflow = '';
          trigger.focus();
        };

        // 入力欄を先に生成しておく（初回タップ時に input が存在し、同期 focus でき
        // モバイルでもワンタップでキーボードが開くようにするため）
        initOnce();
        trigger.addEventListener('click', open);
        modal.addEventListener('click', (e) => {
          // 背景・✕ で閉じる。結果リンクのクリックでも閉じる（同一ページ内アンカーへ
          // 飛ぶ場合はページ遷移が起きずモーダルが残るため）
          if (e.target === modal || e.target.closest('[data-close]') || e.target.closest('.pagefind-ui__result-link')) close();
        });
        // 検索実行（モバイルキーボードの確定/検索キー）で入力欄のフォーカスを外し、
        // ソフトキーボードを閉じて結果を見やすくする。Pagefind が Enter の既定動作を
        // 抑制し submit が発火しない場合があるため keydown でも拾う
        modal.addEventListener('submit', (e) => { e.preventDefault(); });
        modal.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' && e.target.classList && e.target.classList.contains('pagefind-ui__search-input')) {
            e.target.blur();
          }
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && !modal.hidden) close();
          if ((e.key === 'k' && (e.metaKey || e.ctrlKey)) || (e.key === '/' && modal.hidden && !/^(INPUT|TEXTAREA)$/.test(document.activeElement?.tagName))) {
            e.preventDefault();
            open();
          }
        });
      });
    </script>
  </body>
</html>
